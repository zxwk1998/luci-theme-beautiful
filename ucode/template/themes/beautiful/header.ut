-#}

{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board') ?? {};
	const darkpref = (theme == 'beautiful-dark' ? 'true' : (theme == 'beautiful-light' ? 'false' : null));
	const hostname = boardinfo.hostname ?? '?';
	const pagetitle = striptags(_(dispatched?.title ?? ''));

	/* bump on every release so browsers pick up the new stylesheet */
	const assetver = 'c18bca2d';

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" {{ darkpref ? `data-darkmode="${darkpref}"` : '' }}>
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${hostname}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
		{% if (!darkpref): %}
		<script>
			/* resolve the colour scheme before the first paint to avoid a flash */
			(function() {
				var root = document.documentElement;
				if (root.hasAttribute('data-darkmode'))
					return;

				var apply = function(dark) {
					root.setAttribute('data-darkmode', dark ? 'true' : 'false');
				};
				var stored = null;

				try { stored = localStorage.getItem('luci-theme-beautiful:mode'); } catch (e) {}

				if (stored === 'dark' || stored === 'light') {
					apply(stored === 'dark');
				}
				else {
					var mq = window.matchMedia('(prefers-color-scheme: dark)');
					apply(mq.matches);

					if (mq.addEventListener)
						mq.addEventListener('change', function(ev) {
							try {
								if (!localStorage.getItem('luci-theme-beautiful:mode'))
									apply(ev.matches);
							} catch (e) { apply(ev.matches); }
						});
				}
			})();
		</script>
		{% endif %}
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
		<meta name="darkreader-lock">
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
		<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)">
		<link rel="stylesheet" href="{{ media }}/cascade.css?v={{ assetver }}">
		<link rel="stylesheet" media="only screen and (max-device-width: 854px)" href="{{ media }}/mobile.css?v={{ assetver }}">
		<link rel="icon" href="{{ media }}/logo.svg" sizes="any" type="image/svg+xml">
		<link rel="apple-touch-icon" href="{{ media }}/logo.svg">
		{% if (node?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js?v={{ version.luciversion }}"></script>
		<script>
			/* TEMP diagnostics: append ?__diag=1 to surface runtime errors in the tab title */
			(function() {
				if (location.search.indexOf('__diag') < 0)
					return;

				var put = function(s) { document.title = String(s).replace(/\s+/g, ' ').slice(0, 140); };

				window.addEventListener('error', function(e) {
					put('ERR ' + (e.message || '') + ' @' + String(e.filename || '').split('/').pop() + ':' + e.lineno);
				});
				window.addEventListener('unhandledrejection', function(e) {
					var r = e.reason;
					put('REJ ' + (r && (r.message || r)));
				});
			})();
		</script>
	</head>

	<body class="lang_{{ dispatcher.lang }} {{ entityencode(striptags(dispatched?.title ?? ''), true) }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
		{% if (!blank_page): %}
		<div class="app">
			<aside class="app-sidebar" id="app-sidebar" aria-label="{{ _('Main navigation') }}">
				<div class="app-sidebar-inner">
					<div class="sidebar-brand-row">
						<a class="sidebar-brand" href="/">
							<span class="brand-logo" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
									<path d="M12 2.5c.38 3.1.38 3.1 1.5 4.22 1.12 1.12 1.12 1.12 4.22 1.5-3.1.38-3.1.38-4.22 1.5-1.12 1.12-1.12 1.12-1.5 4.22-.38-3.1-.38-3.1-1.5-4.22C9.38 8.6 9.38 8.6 6.28 8.22c3.1-.38 3.1-.38 4.22-1.5C11.62 5.6 11.62 5.6 12 2.5Z"/>
									<circle cx="17.75" cy="18" r="1.75" opacity=".7"/>
									<circle cx="7" cy="16.5" r="2.5" opacity=".35"/>
								</svg>
							</span>
							<span class="brand-text">
								<span class="brand-name">{{ hostname }}</span>
								<span class="brand-desc">{{ boardinfo.model ?? 'LuCI' }}</span>
							</span>
						</a>
						<button class="btn-icon sidebar-close" id="sidebar-close" type="button" aria-label="{{ _('Close') }}">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
								<path d="M18 6 6 18M6 6l12 12"/>
							</svg>
						</button>
					</div>

					<div class="sidebar-scroll">
						<ul class="sidebar-nav" id="topmenu" style="display:none"></ul>
					</div>

					<div class="sidebar-footer">
						<ul class="mode-menu" id="modemenu" style="display:none"></ul>
						<div class="sidebar-version">
							{{ version.luciversion }}
						</div>
					</div>
				</div>
			</aside>

			<div class="app-scrim" id="sidebar-scrim" hidden></div>

			<div class="app-body">
				<header class="app-topbar">
					<button class="btn-icon sidebar-trigger" id="sidebar-open" type="button"
					        aria-label="{{ _('Menu') }}" aria-controls="app-sidebar" aria-expanded="false">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
							<path d="M4 6h16M4 12h16M4 18h16"/>
						</svg>
					</button>

					<div class="topbar-nav">
						<div class="topbar-titles">
							<ol class="breadcrumb" id="breadcrumb"></ol>
							<h1 class="topbar-title">{{ pagetitle }}</h1>
						</div>
					</div>

					<div class="topbar-actions">
						<div id="indicators" class="indicators"></div>
						<button class="btn-icon theme-toggle" id="theme-toggle" type="button"
						        aria-label="{{ _('Toggle colour scheme') }}" title="{{ _('Toggle colour scheme') }}">
							<svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>
							</svg>
							<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="4"/>
								<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
							</svg>
						</button>
					</div>
				</header>

				<main class="app-main" id="maincontent">
					<div class="app-main-inner">
						{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
							<div class="alert-message warning">
								<h4>{{ _('No password set!') }}</h4>
								<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
								{% if (dispatcher.lookup("admin/system/admin")): %}
								<div class="right"><a class="btn important" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
								{% endif %}
							</div>
						{% endif %}

						{% if (boardinfo.rootfs_type == "initramfs"): %}
							<div class="alert-message warning">
								<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
								<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
								{% if (dispatcher.lookup("admin/system/flash")): %}
								<div class="right"><a class="btn important" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
								{% endif %}
							</div>
						{% endif %}

						<noscript>
							<div class="alert-message warning">
								<h4>{{ _('JavaScript required!') }}</h4>
								<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
							</div>
						</noscript>

						<div id="tabmenu" class="tabmenu-host" style="display:none"></div>
		{% endif %}
